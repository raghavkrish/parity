# Website parity checker — all runtime configuration.
# Copy to .env and adjust. Values here are local defaults.

# --- Web app ---
HOST=127.0.0.1
PORT=3000
MAX_PAGES=25
RUN_TIMEOUT_MS=240000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=parity
# 1 = allow loopback/private fixture URLs. Keep 0 on public hosts.
ALLOW_PRIVATE_ORIGINS=0
# debug | info | warn | error. Fetch/compare lines are info; image/redirect hops are debug.
LOG_LEVEL=info
# text (default, one line) or json
LOG_FORMAT=text

# --- CLI (`npm run check`) ---
OLD_ORIGIN=http://127.0.0.1:4173
NEW_ORIGIN=http://127.0.0.1:4174
MAPPING=fixtures/mapping.csv
REPORT=reports/latest.html

# --- Demo (`npm run demo`) ---
OLD_PORT=4173
NEW_PORT=4174
DEMO_HOLD_MS=60000
